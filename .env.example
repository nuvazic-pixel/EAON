# EAON 2.0 Environment Configuration
# ====================================
# Copy to .env and fill in your values

# App Settings
APP_NAME=EAON
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=/var/log/eaon/eaon.log

# Orchestrator
EAON_DEFAULT_MODEL=llama3
EAON_FALLBACK_MODEL=mistral
EAON_SAFE_MODE_MODEL=mistral
EAON_HIGH_RISK_THRESHOLD=40
EAON_MEDIUM_RISK_THRESHOLD=20
EAON_TIMEOUT=30
EAON_MAX_RETRIES=2
EAON_ENABLE_CRITIC=true

# INTEL Layer
INTEL_ENABLED=true
INTEL_HIGH_RISK_CC=KP,IR,RU,CN,BY
INTEL_MEDIUM_RISK_CC=VN,PK,NG,UA,RO
INTEL_CACHE_TTL=3600
INTEL_CACHE_PREFIX=intel:

# GeoIP
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_FALLBACK_URL=http://ip-api.com/json/{ip}

# API Keys (get from respective services)
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Slack (get webhook URL from Slack app)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#eaon-alerts
SLACK_USERNAME=EAON
SLACK_ICON_EMOJI=:robot_face:
SLACK_NOTIFY_BLOCK=true
SLACK_NOTIFY_REVIEW=true
SLACK_NOTIFY_HIGH_RISK=true
SLACK_HIGH_RISK_THRESHOLD=40

# JIRA
JIRA_ENABLED=false
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task
JIRA_CREATE_ON_BLOCK=true
JIRA_CREATE_ON_HIGH_RISK=true
JIRA_HIGH_RISK_THRESHOLD=50
